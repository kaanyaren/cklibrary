rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /covers/{bookId}/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email in ['kaanyaren@gmail.com', 'ceyda.d@gmail.com']
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
